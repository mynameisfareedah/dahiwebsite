VITE_SUPABASE_STORAGE_BUCKET=events
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
VITE_GA_MEASUREMENT_ID=G-DYGDHWEX4X
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Server-side Substack feed URL (used by Netlify function)
# Leave unset to use the default baked into the function
SUBSTACK_FEED_URL=https://womenshealthwithdocadi.substack.com/feed
